		{
			"id": "XRI4IKyG",
			"type": "text",
			"x": 58.44599919539996,
			"y": 905.5574298695144,
			"text": "Kprobe                                    │ Uprobe\n─────────────────────────────────────────┼────────────────────────────────────────\n数据来源: 内核 syscall                   │ 数据来源: 用户态函数\n数据内容: 原始字节流                     │ 数据内容: 明文协议数据\n协议感知: 无，需协议推断                  │ 协议感知: 直接获取明文\n加密流量: 只能拿到密文                  │ 加密流量: 可通过 TLS uprobe 拿密钥\n覆盖范围: 所有进程                      │ 覆盖范围: 特定语言/框架\n典型场景: 通用抓包                       │ 典型场景: HTTP2/gRPC/TLS 明文抓取",
			"fontSize": 9,
			"fontFamily": 3,
			"containerId": null,
			"originalText": "Kprobe                                    │ Uprobe\n─────────────────────────────────────────┼────────────────────────────────────────\n数据来源: 内核 syscall                   │ 数据来源: 用户态函数\n数据内容: 原始字节流                     │ 数据内容: 明文协议数据\n协议感知: 无，需协议推断                  │ 协议感知: 直接获取明文\n加密流量: 只能拿到密文                  │ 加密流量: 可通过 TLS uprobe 拿密钥\n覆盖范围: 所有进程                      │ 覆盖范围: 特定语言/框架\n典型场景: 通用抓包                       │ 典型场景: HTTP2/gRPC/TLS 明文抓取",
			"autoResize": true,
			"lineHeight": 1.2,
			"width": 432.421875,
			"height": 86.39999999999999,
