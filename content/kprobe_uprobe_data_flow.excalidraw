		{
			"id": "cORjmtU8",
			"type": "text",
			"x": 58.44599919539996,
			"y": 705.5574298695144,
			"text": "struct __socket_data {\n    __u32 pid;              // 进程 ID\n    __u64 timestamp;        // ns 时间戳\n    struct tuple5 tuple;    // 五元组\n    __u32 tcp_seq;          // TCP 序列号\n    __u8 direction;         // 方向 (ingress/egress)\n    __u8 data[CAP_DATA_SIZE];  // 前 N 字节业务数据 (通常 1000B)\n    __u32 data_len;        // 实际数据长度\n    __u32 socket_id;        // 全局唯一 socket 标识\n    ...\n}",
			"fontSize": 10,
			"fontFamily": 3,
			"containerId": null,
			"originalText": "struct __socket_data {\n    __u32 pid;              // 进程 ID\n    __u64 timestamp;        // ns 时间戳\n    struct tuple5 tuple;    // 五元组\n    __u32 tcp_seq;          // TCP 序列号\n    __u8 direction;         // 方向 (ingress/egress)\n    __u8 data[CAP_DATA_SIZE];  // 前 N 字节业务数据 (通常 1000B)\n    __u32 data_len;        // 实际数据长度\n    __u32 socket_id;        // 全局唯一 socket 标识\n    ...\n}",
