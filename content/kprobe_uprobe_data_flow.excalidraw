			"text": "Kprobe vs Uprobe 对比",
			"fontSize": 12,
			"fontFamily": 1,
			"fontWeight": true,
			"containerId": null,
			"originalText": "Kprobe vs Uprobe 对比",
			"autoResize": true,
			"lineHeight": 1.25,
			"width": 131.48492431640625,
