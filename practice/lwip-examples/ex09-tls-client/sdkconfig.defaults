# 必填：OpenCores Ethernet MAC 驱动（仅 QEMU 可用，真机不可用）
CONFIG_ETH_USE_OPENETH=y

# QEMU 不仿真 ESP32 硬件加密外设：纯软件密码实现（与 ch22 同口径，测量数字才可比）。
# 真机工程删掉这三行即可恢复硬件加速。
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_SHA=n
CONFIG_MBEDTLS_HARDWARE_MPI=n

# 教学模板默认姿势：自签证书不在任何信任链里，开启全局跳过服务器证书验证。
# 生产工程严禁开启这两项！升级到 CA 固定（pinning）的完整路径见
# README「证书验证升级」一节 + main.c 里 tls_connect() 的注释。
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
