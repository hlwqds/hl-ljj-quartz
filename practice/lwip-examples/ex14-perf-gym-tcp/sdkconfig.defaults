# ex14 默认档 = 场景 0 健康基线（与 sdkconfig.defaults.sc0 同内容）。
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │ ⚠ 切场景标准三步（Batch 1 教训，跳步必翻车）：                          │
# │   cp sdkconfig.defaults.scN sdkconfig.defaults                          │
# │   rm -f sdkconfig        # ← 必须删！defaults 只在 sdkconfig 缺席时生效    │
# │   idf.py build           # 重新生成全量 sdkconfig                         │
# │ 残留旧 sdkconfig 会静默吃掉新预设——开机 EX14FACT 行会打印生效值供核对。 │
# └──────────────────────────────────────────────────────────────────────────┘
#
# 场景文件清单：sc0(本文件)/sc1/sc1.fixed/sc2/sc2.fixed/sc3/sc3.fixed/sc4/sc4.fixed
# 各场景语义与坏/修对照见 README。

# ---- 必填：QEMU openeth 虚拟网卡 -----------------------------------------
CONFIG_ETH_USE_OPENETH=y

# ---- 可观测性：lwip_stats 协议计数（诊断读数的来源，EX14STATS 行依赖）----
# IDF lwIP 全堆化：无 MEM/MEMP 静态段输出；内存观测走 heap_caps，不要找 memp 池。
CONFIG_LWIP_STATS=y

# ---- 口径锁定：与套件基线对齐（5760/5760/1440 = ex11 base & ch24 base 口径）----
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760

# ---- 场景号：健康基线 ------------------------------------------------------
CONFIG_GYM_SCENARIO=0
