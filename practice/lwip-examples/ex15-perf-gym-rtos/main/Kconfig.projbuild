menu "EX15 perf-gym-rtos Configuration"

    config GYM_SCENARIO
        int "Fault scenario (0=healthy baseline 1=prio-starve 2=slow-raw-callback 3=mbox-flood 4=stack-hwm)"
        range 0 4
        default 0
        help
            0 健康基线；1 双核高优自旋饿死低优心跳（ch19 占空比实验）；
            2 raw 回调里做慢操作拖死 tcpip 线程（ch13 实验 C 应用版）；
            3 高频投递打满 32 槽 tcpip 邮箱（ch13 实验 D 应用版）；
            4 任务栈余量耗尽告警教学（HWM 观测，不含真溢出崩溃）。

    # ---------------- 注入时序 ----------------

    config EX15_RUN_WINDOW_S
        int "Total observed window after READY (s)"
        range 30 120
        default 75

    config EX15_INJECT_AT_S
        int "Inject fault at t+X s after READY"
        range 5 60
        default 12

    config EX15_REMOVE_AT_S
        int "Remove fault at t+X s after READY"
        range 15 118
        default 42

    # ---------------- 被害者：双层心跳 ----------------

    config EX15_HB_PERIOD_MS
        int "RTOS heartbeat period (ms)"
        default 500

    config EX15_HB_PRIO
        int "RTOS heartbeat task priority"
        range 1 24
        default 5
        help
            默认 5：低优先级样本，让场景 1（高优自旋）能饿死它。
            场景 3 变体把它提到 19（压过 tcpip=18）：考察纯邮箱水位时隔离
            调度维度的连带伤害——即 Batch 4/7 的"测量探针优先级要压过
            tcpip(18)"纪律的应用。

    config EX15_SCHED_ALARM_GAP_MS
        int "RTOS heartbeat gap that raises kind=sched alarm (ms)"
        default 2500

    config EX15_PING_INTERVAL_MS
        int "Network heartbeat (esp_ping) interval (ms)"
        default 1000

    config EX15_PING_TIMEOUT_MS
        int "Network heartbeat per-probe timeout (ms)"
        default 800

    config EX15_NET_ALARM_AFTER
        int "Consecutive net-heartbeat failures to raise kind=net alarm"
        range 1 10
        default 2

    # ---------------- 场景 1：优先级倒挂 ----------------

    config EX15_SC1_DUTY_PCT
        int "SC1 spinner duty cycle (%) applied on both pinned cores"
        range 50 100
        default 100
        help
            ch19 实测分水岭：单核钉核自旋 duty<=70% 存活、70%~85% 引爆、100% 全灭。
            本示例两核各钉一个 spinner，默认 100%（复现"全灭且 serial 无声"的干净样本）；
            想亲手踩 70%~85% 分水岭请调低后重测。

    config EX15_SC1_SPIN_PRIO
        int "SC1 spinner priority (must stay above tcpip=18, below observer=22)"
        range 19 21
        default 20

    # ---------------- 场景 2：回调慢操作 ----------------

    config EX15_SC2_BUSY_MS
        int "SC2 busy-wait duration inside raw UDP recv callback (ms)"
        range 100 2000
        default 900
        help
            必须大于 EX15_PING_TIMEOUT_MS 才能稳定触发 kind=net 告警：
            每次 STALL 都把探测的应答窗整个吞掉。

    config EX15_SC2_PERIOD_MS
        int "SC2 trigger datagram period (ms)"
        range 50 5000
        default 250

    # ---------------- 场景 3：邮箱打满 ----------------

    config EX15_SC3_WORKERS
        int "SC3 flood worker task count"
        range 1 6
        default 3

    config EX15_SC3_BURST_N
        int "SC3 capacity-probe burst size (expect first N-32 accepted)"
        range 33 256
        default 64

    config EX15_SC3_WORK_US
        int "SC3 per-callback work in tcpip thread (us)"
        range 0 4000
        default 400
        help
            让被淹没端"消化变慢"的诚实模拟：真实系统投进邮箱的消息本就带工作量。
            0 = 空回调（消化 ~22µs/条，ch13 口径），难以稳定打满。

    config EX15_SC3_PACE_MS
        int "SC3 forced sleep between posts per worker (ms)"
        range 1 20
        default 1
        help
            生产者礼貌性节流：不带它，永不阻塞的 flood 循环会把低于自己优先级
            的心跳任务一并饿死，污染本场景的"纯邮箱"叙事（那属于场景 1）。

    # ---------------- 场景 4：栈余量耗尽 ----------------

    config EX15_SC4_STACK_BYTES
        int "SC4 victim task stack size (bytes)"
        range 1024 8192
        default 4096

    config EX15_SC4_CHUNK
        int "SC4 per-level local array chunk (bytes)"
        range 64 512
        default 256

    config EX15_SC4_ALARM_HWM
        int "SC4 high-water alarm threshold: free bytes below this fires kind=stk"
        range 384 2048
        default 1024
        help
            告警要早于危险：阈值必须高于绝对安全地板（EX15_SC4_STOP_MARGIN，
            默认 768），否则永远轮不到告警就已经踩到护栏。

    config EX15_SC4_STOP_MARGIN
        int "SC4 absolute safety floor: stop descending at this much free"
        range 384 3072
        default 768
        help
            实测教训：首版地板设 192B 时，步进之间的 printf（自身要用几百字节栈）
            直接把栈底打穿——backtrace 里出现 0xa5a5a5a5 CORRUPTED。地板必须为
            "你要在栈上继续干的活"留足余量。

endmenu
