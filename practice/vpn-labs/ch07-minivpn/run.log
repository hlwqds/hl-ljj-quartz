./minivpn-linux --loopback                     # 自环自检（无需 root）
A# ./minivpn-linux --tun tun0 --key vpn.key --role a --peer B:51820 --port 51820
B# ./minivpn-linux --tun tun0 --key vpn.key --role b --peer A:51820 --port 51820
